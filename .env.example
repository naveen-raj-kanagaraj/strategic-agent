# Required
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=           # your Telegram user ID: no limits, full briefings, owner commands
OWNER_TIMEZONE=America/Chicago
DAILY_LIMIT=20               # requests per day for everyone else
PUBLIC_DAILY_BUDGET_USD=0.50 # all other users together; they pause for the day when reached
OWNER_DAILY_BUDGET_USD=3.00  # safety net for your own usage; 0 disables

# Optional: more models for the picker (each appears once its key is set)
OPENAI_API_KEY=              # platform.openai.com > API keys (separate billing)
# Model IDs/prices can be overridden per model, e.g. GPT_SOL_MODEL_ID=..., GEMINI_PRO_PRICE=2,12
# (see core/models.py for the full list: Haiku, Sonnet, Opus, Fable, GPT Luna/Terra/Sol, Gemini Flash-Lite/Flash/Pro)
GEMINI_API_KEY=              # aistudio.google.com > Get API key

PICKER_SESSION_HOURS=2
THINKING=off                 # starting thinking depth for your chats: off, low, medium, high (/thinking changes it)
REPLY_MAX_TOKENS=2048        # longest reply allowed (~1,500 words)
ACTIVITY_DAYS=30             # how long the activity log is kept
GROUPS_ENABLED=true          # answer in Telegram groups when mentioned or replied to
BACKUP_TIME=03:00            # nightly database backup (iCloud Drive/PesAgentBackups if available)
BACKUP_KEEP=7
BACKUP_DIR=                  # optional: another backup folder        # keep using the chosen model until this long without messages

# Dashboard (http://localhost:8090 on the computer running the agent)
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8090
DASHBOARD_TOKEN=             # set this before exposing it beyond this computer

# Web search (serper.dev)
SERPER_API_KEY=

# Discord (optional)
DISCORD_BOT_TOKEN=
ALLOWED_DISCORD_IDS=

# Owner briefing
DIGEST_TO=telegram            # telegram, discord or both
DIGEST_TIMES=08:00,19:00      # local times for the daily briefs
BREAKING_EVERY_MIN=20         # 0 turns breaking-news checks off

# Personalised news for every user (their local time)
NEWS_TIMES=08:00,19:00

# News sources (Google News, Reddit and Hacker News are free; X/IG/Threads and YouTube use 1 Serper credit each per topic)
NEWS_WINDOW_HOURS=24         # only items newer than this
NEWS_CACHE_MINUTES=30        # reuse a search for this long before checking again
NEWS_SOCIAL=true
NEWS_YOUTUBE=true
NEWS_FEEDS=                  # extra RSS feeds, comma-separated
# Reddit closed self-service API keys (Nov 2025) and blocks free access (May 2026). Without keys the bot reads
# Reddit through Google's index via Serper (about 1 credit per news topic). Set false to skip Reddit entirely.
REDDIT_VIA_GOOGLE=true
# Only if Reddit ever approves you for API access:
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Content radar for the owner
RADAR_TIME=10:00             # empty disables
RADAR_TOPICS=                # comma-separated; empty = creator economy, talent, entertainment, brands, gaming, media funding
RADAR_SUBREDDITS=NewTubers,CreatorsAdvice,socialmedia,marketing,IndianGaming,bollywood,StartUpIndia
RADAR_COMPETITORS=           # comma-separated channel names to watch

# Keyword alerts (free: news sites, Reddit, Hacker News)
ALERT_EVERY_MIN=10
ALERT_MAX_AGE_HOURS=6
MAX_WATCHES_PUBLIC=3

# Talent tracker weekly summary (Mondays, your local time)
PIPELINE_WEEKLY_TIME=09:00

# Extras
PUBLIC_IMAGE_GEN=false       # let non-owners generate images
WHISPER_MODEL=base           # small = better for Tamil/Hindi mixes, bigger download

# WhatsApp via Twilio (optional, off unless ENABLE_WHATSAPP=true)
ENABLE_WHATSAPP=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
MY_WHATSAPP_NUMBER=

# Credit protection
PER_USER_DAILY_USD=0.10          # max one person can spend per day
CREDIT_RESERVE_USD=1.00          # below this estimated balance (/credits), only you can use the bot
LOW_BALANCE_ALERT_USD=3.00       # warn you when the balance drops below this
# Live topic updates
LIVE_EVERY_MIN=15
LIVE_MAX_PER_DAY=8
LIVE_MAX_TOPICS_PER_RUN=60
NEWS_CATCHUP_MIN=180             # send a missed 8 AM brief up to 3h late after downtime
# Group safety
GROUP_COOLDOWN_SEC=15            # one question per person per group every N seconds
GROUP_MAX_PER_HOUR=40            # per group
GROUP_MAX_PER_DAY=150            # per group
INLINE_COOLDOWN_SEC=5            # @bot questions in other chats, per person
# Telegram channels you've joined (optional, read-only). Create keys at https://my.telegram.org > API development
# tools, put them here, then run once on your computer: python scripts/telegram_login.py
TG_API_ID=
TG_API_HASH=
CHANNEL_EVERY_MIN=5             # how often channels are checked
CHANNELS_INCLUDE_ARCHIVED=false  # skip channels you've archived in Telegram
CHANNELS_MAX_PER_USER=10         # public channels each user can follow with /channels add

# ---------- voice alerts and trends ----------
VOICE_ALERTS=true                 # trending alerts also come as a voice note
VOICE_NAME=en-IN-PrabhatNeural    # any edge-tts voice, e.g. en-US-GuyNeural, en-IN-NeerjaNeural
TREND_EVERY_MIN=20                # how often to look for trends (0 = off); quiet 11 PM to 7 AM
TREND_GEOS=IN,US                  # Google trending searches to match against
# Gmail (read only) + Google Calendar: python scripts/google_login.py client_secret.json, then bash scripts/server.sh google

# ---------- reasoning, background tasks ----------
REASONING=true          # understand-what-I-mean pass before answering + fact check after (owner only, ~1 cent/message)
MAX_BG_TASKS=6          # background tasks ("keep me posted on X") running at once
LOOSE_ENDS_TIME=19:00   # daily "loose ends" check from your recent chats (server time; empty = off)
